<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pure core. No I/O and no project references, SmartTV.App depends on
       this and never the reverse. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>H.L, LionsHead Analytics Group</Authors>
    <Company>LionsHead Analytics Group</Company>
    <Copyright>Copyright (c) 2026 HL.</Copyright>
  </PropertyGroup>

  <!-- order matters in F#, a file can only use what compiles above it -->
  <ItemGroup>
    <Compile Include="SubnetCore.fs" />
    <Compile Include="ArpCore.fs" />
    <Compile Include="MdnsCore.fs" />
    <Compile Include="DeviceCore.fs" />
  </ItemGroup>

</Project>
